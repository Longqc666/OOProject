@startuml
title 续借 UC-03 关键类图

skinparam classAttributeIconSize 0

class Patron {
  +patronId: PatronId
  +patronType: PatronType
}

class BibliographicRecord {
  +bibId: BibId
  +title: String
  +isbn: String
}

class Item {
  +itemId: ItemId
  +barcode: String
  +status: ItemStatus
}

class Loan {
  +loanId: LoanId
  +borrowedAt: LocalDate
  +dueDate: LocalDate
  +renewCount: int
  +status: LoanStatus
  +renew(newDueDate: LocalDate): void
  +isOverdue(asOf: LocalDate): boolean
}

class Reservation {
  +reservationId: ReservationId
  +queuePosition: int
  +status: ReservationStatus
}

class RenewRuleSet {
  +ruleVersionId: RuleVersionId
  +effectiveFrom: Instant
  +maxRenewCount(patronType: PatronType): int
  +renewPeriodDays(): int
  +allowRenewWhenReserved(): boolean
  +allowRenewWhenOverdue(): boolean
}

class RuleEvaluator {
  +evaluate(loan: Loan, patron: Patron, hasReservation: boolean, ruleSet: RenewRuleSet): RuleDecision
}

class RenewalApplication {
  +renewalId: RenewalId
  +requestedAt: Instant
  +idempotencyKey: String
  +ruleVersionId: RuleVersionId
  +decision: RuleDecision
  +newDueDate: LocalDate
}

class RuleDecision {
  +eligible: boolean
  +reason: RejectReason
}

Patron "1" -- "0..*" Loan : 借阅 >
BibliographicRecord "1" -- "1..*" Item : 包含 >
Item "1" -- "0..*" Loan : 被借 >
Item "1" -- "0..*" Reservation : 被预约 >
Loan "1" -- "0..1" RenewalApplication : 续借申请 >
RenewRuleSet "1" -- "0..*" RenewalApplication : 按版本判定 >
RuleEvaluator ..> RenewRuleSet : 使用 >
RuleEvaluator ..> Loan : 求值 >
RuleEvaluator ..> RuleDecision : 产出 >
RenewalApplication "1" *-- "1" RuleDecision : 记录判定 >
@enduml
