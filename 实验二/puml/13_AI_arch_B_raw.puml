@startuml
title 方案二 组件图 - 领域服务拆分（借阅核心 / 规则服务 / ILS 网关）

skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "读者\n(Web/App)" as Reader
actor "馆员" as Librarian

package "借阅流通子系统" {

  package "借阅核心服务 Loan Core Service" {
    [Circulation API\n续借入口] as Api
    [RenewApplicationService] as AppSvc
    [RenewDomainService] as RenewDS
    [Loan 聚合] as LoanAgg
    [Reservation 聚合] as ResvAgg
    [Patron / Bib / Item\n本地只读投影] as Projection
    [AuditWriter\n同源审计] as AuditW
    [Outbox] as Outbox
  }

  package "规则服务 Rule Service" {
    [Rule API\n按版本求值] as RuleApi
    [RuleSet 版本库\nRuleEvaluator] as RuleEval
  }

  package "ILS 网关服务 Ils Gateway Service" {
    [Ils Gateway API\n幂等键/重试/熔断] as IlsGw
    [IdempotencyStore\n幂等键] as Idem
    [Reconciler\n对账任务] as Recon
  }

  package "投影同步器 Projection Sync" {
    [Patron/Bib/Item\n同步器] as Sync
  }
}

package "外部系统" {
  [现有 ILS\n(仅 REST)] as ILS
  [统一身份认证] as SSO
}

Reader --> Api
Librarian --> Api

Api --> AppSvc
AppSvc --> RenewDS
AppSvc --> LoanAgg
AppSvc --> ResvAgg
AppSvc --> Projection
AppSvc --> RuleApi : 同步 gRPC/REST\n带规则版本
AppSvc --> IlsGw : 同步 提交续借\n带幂等键
AppSvc --> AuditW
AppSvc --> Outbox

RenewDS --> LoanAgg
RenewDS --> ResvAgg
RuleApi --> RuleEval
IlsGw --> Idem
IlsGw --> ILS : REST
Recon --> ILS : 对账查询
Recon --> IlsGw
Sync --> Api

Api --> SSO : 鉴权
@enduml
