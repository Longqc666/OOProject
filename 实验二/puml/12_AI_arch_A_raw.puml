@startuml
title 方案一 组件图 - 模块化单体 + 六边形端口适配器

skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "读者\n(Web/App)" as Reader
actor "馆员" as Librarian

package "借阅流通子系统（单一部署单元）" {

  package "入站适配器 Inbound Adapters" {
    [流通 REST Controller\n(Circulation API)] as InCtrl
    [ILS 回调/对账入口\n(Reconcile Endpoint)] as RecCtrl
  }

  package "应用层 Application" {
    [RenewApplicationService\n续借用例编排] as AppSvc
    [ReconcileApplicationService\n对账用例] as RecSvc
  }

  package "领域层 Domain" {
    package "借阅模块" {
      [Loan 聚合\nLoan / LoanRenewal] as LoanAgg
      [RenewDomainService\n续借领域服务] as RenewDS
    }
    package "预约模块" {
      [Reservation 聚合\nReservationQueue] as ResvAgg
    }
    package "规则模块" {
      [RenewRuleSet\n版本化规则] as RuleSet
      [RuleEvaluator\n规则判定器] as RuleEval
    }
    package "馆藏模块" {
      [BibliographicRecord\n书目] as Bib
      [Item 副本] as Item
      [Patron 读者] as Patron
    }
  }

  package "出站端口 Outbound Ports (Interfaces)" {
    [IlsPort\n借还/续借远端调用] as IlsPort
    [LoanRepositoryPort] as LoanRepoPort
    [ReservationRepositoryPort] as ResvRepoPort
    [RuleRepositoryPort] as RuleRepoPort
    [AuditPort\n同源审计] as AuditPort
    [IdempotencyPort\n幂等键存储] as IdemPort
    [OutboxPort\n事务性发件箱] as OutboxPort
  }

  package "出站适配器 Outbound Adapters" {
    [IlsRestAdapter\n超时/重试/幂等键] as IlsAdapter
    [JpaLoanRepository] as LoanRepo
    [JpaReservationRepository] as ResvRepo
    [JpaRuleRepository] as RuleRepo
    [JpaAuditRepository\n与业务同库同事务] as AuditRepo
    [JpaIdempotencyRepository] as IdemRepo
    [JpaOutboxRepository] as OutboxRepo
  }
}

package "外部系统（不画实现细节）" {
  [现有 ILS\n(仅 REST)] as ILS
  [统一身份认证] as SSO
}

Reader --> InCtrl
Librarian --> InCtrl
InCtrl --> AppSvc
RecCtrl --> RecSvc

AppSvc --> RenewDS
AppSvc --> RuleEval
AppSvc --> LoanAgg
AppSvc --> ResvAgg
AppSvc --> IlsPort
AppSvc --> LoanRepoPort
AppSvc --> ResvRepoPort
AppSvc --> AuditPort
AppSvc --> IdemPort
AppSvc --> OutboxPort

RenewDS --> RuleSet
RenewDS --> LoanAgg
RuleEval --> RuleSet

LoanAgg --> Bib
LoanAgg --> Item
LoanAgg --> Patron

IlsPort <|.. IlsAdapter
LoanRepoPort <|.. LoanRepo
ResvRepoPort <|.. ResvRepo
RuleRepoPort <|.. RuleRepo
AuditPort <|.. AuditRepo
IdemPort <|.. IdemRepo
OutboxPort <|.. OutboxRepo

IlsAdapter --> ILS : REST
InCtrl --> SSO : 鉴权
@enduml
