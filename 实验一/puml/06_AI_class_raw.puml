@startuml
skinparam classAttributeIconSize 0
hide empty members

class 读者 {
  - 读者编号 : String
  - 姓名 : String
  - 读者类型 : 读者类型
  - 账户状态 : 账户状态
  + 续借(条码 : String) : 续借结果
}

class 图书管理员 {
  - 工号 : String
  - 姓名 : String
  + 代读者续借(读者编号 : String, 条码 : String) : 续借结果
}

class 智能助手 {
  - 助手编号 : String
  + 辅助续借(读者编号 : String, 条码 : String) : 续借结果
}

class ILS接口 {
  + 查询借阅记录(读者编号 : String) : 借阅记录
  + 续借事务(条码 : String, 新应还日期 : Date) : 续借结果
}

class 书目 {
  - ISBN : String
  - 书名 : String
  - 著者 : String
  + 是否有他人预约() : boolean
}

class 副本 {
  - 条码 : String
  - 馆藏地 : String
  - 副本状态 : 副本状态
}

class 借阅记录 {
  - 记录编号 : String
  - 借出日期 : Date
  - 应还日期 : Date
  - 续借次数 : int
  - 记录状态 : 借阅状态
  + 是否逾期() : boolean
  + 续借(新应还日期 : Date) : void
}

class 续借服务 {
  + 续借(读者编号 : String, 条码 : String) : 续借结果
  - 校验资格(记录 : 借阅记录) : boolean
  - 计算新应还日期(记录 : 借阅记录) : Date
  - 提交续借事务(记录 : 借阅记录) : void
}

class 续借规则 {
  - 学生最大次数 : int = 2
  - 教师最大次数 : int = 5
  - 顺延天数 : int = 30
  + 校验次数上限(类型 : 读者类型, 次数 : int) : boolean
  + 校验预约(记录 : 借阅记录) : boolean
  + 校验逾期(记录 : 借阅记录) : boolean
}

class 续借结果 {
  - 成功 : boolean
  - 消息 : String
  - 新应还日期 : Date
}

enum 读者类型 {
  学生
  教师
}

enum 账户状态 {
  正常
  冻结
  欠费
}

enum 副本状态 {
  可借
  已借出
  已预约
  遗失
}

enum 借阅状态 {
  借阅中
  已归还
  已逾期
  已续借
}

' ---- 参与者与外部接口 ----
读者 "1" --> "0..*" 借阅记录 : 关联 >
图书管理员 "1" --> "0..*" 借阅记录 : 关联 >
智能助手 "1" --> "0..*" 借阅记录 : 关联 >

读者 --> 续借服务 : 依赖 >
图书管理员 --> 续借服务 : 依赖 >
智能助手 --> 续借服务 : 依赖 >

续借服务 --> 续借规则 : 依赖 >
续借服务 --> 续借结果 : 依赖 >
续借服务 --> ILS接口 : 依赖 >

' ---- 书目与副本：组合，按条码借阅 ----
书目 "1" *-- "1..*" 副本 : 组合 >

' ---- 副本与借阅记录：关联，多重性 ----
副本 "1" --> "0..*" 借阅记录 : 关联 >
借阅记录 "*" --> "1" 副本 : 关联 >

' ---- 记录与状态：关联 ----
借阅记录 --> 借阅状态 : 关联 >
副本 --> 副本状态 : 关联 >
读者 --> 读者类型 : 关联 >
读者 --> 账户状态 : 关联 >

@enduml
